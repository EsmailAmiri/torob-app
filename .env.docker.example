# Copy to .env.docker after you have a reachable HTTPS endpoint and model key.
# This file is loaded only by the container; keep the real .env.docker private.
LLM_PROVIDER=9router
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_STYLE=chat_completions
# Set this to the public HTTPS origin when deploying behind a reverse proxy.
# APP_ORIGIN=https://your-domain.example
