{
  "name": "torob-hamrah",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --config vite.node.config.ts --host 127.0.0.1",
    "dev:api": "node --env-file-if-exists=.env --import tsx server/node.ts",
    "build": "vite build && node scripts/finalize-worker.mjs",
    "build:node": "vite build --config vite.node.config.ts",
    "start": "node --env-file-if-exists=.env --import tsx server/node.ts",
    "preview": "wrangler dev --config dist/server/wrangler.json --local --ip 127.0.0.1 --port 4173 --persist-to .wrangler/state",
    "data": "python scripts/prepare_data.py && npm run db:seed",
    "db:seed": "python scripts/seed_sqlite.py",
    "db:generate": "drizzle-kit generate",
    "test": "node --import tsx --test tests/*.test.*",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@langchain/langgraph": "^1.0.0",
    "drizzle-orm": "^0.45.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "openai": "^6.0.0",
    "playwright": "^1.64.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.20.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "wrangler": "^4.0.0"
  }
}
