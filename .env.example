# Server only. Never use a VITE_ prefix for secrets.
# 9router: use your own server URL and a model ID from its /v1/models endpoint.
LLM_PROVIDER=9router
LLM_API_KEY=
LLM_BASE_URL=http://127.0.0.1:20128/v1
LLM_MODEL=
LLM_API_STYLE=chat_completions
# Direct OpenAI is also supported: LLM_PROVIDER=openai, LLM_API_STYLE=responses.
# Legacy OPENAI_API_KEY / OPENAI_MODEL / OPENAI_BASE_URL remain supported.
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=runtime/torob.sqlite
